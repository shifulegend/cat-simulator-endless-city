# .env.example
# Copy to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# All secrets must be injected as environment variables, never hard-coded.

# ── App ──────────────────────────────────────────────────
APP_ENV=development            # development | staging | production
APP_PORT=3000
APP_SECRET=change-me-to-a-random-secret

# ── Database (Supabase) ──────────────────────────────────
# Public values below are SAFE to expose in frontend/client code (Vite bundles
# VITE_-prefixed vars into the browser build). Security is enforced via
# Postgres Row Level Security (RLS) policies in Supabase, not by hiding these.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# NEVER put SUPABASE_SERVICE_ROLE_KEY here or in any VITE_-prefixed var.
# The service_role key must only ever live in Supabase Edge Function secrets
# or a GitHub Actions secret used for server-side/CI tasks — never in a file
# that ships to the browser or gets committed to Git.
# SUPABASE_SERVICE_ROLE_KEY=

# ── External APIs ────────────────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=

# ── Auth ─────────────────────────────────────────────────
# JWT_SECRET=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
